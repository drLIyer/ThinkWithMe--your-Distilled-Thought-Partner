# Copy this to .env and fill in your values

# Anthropic API
ANTHROPIC_API_KEY=your-api-key-here
# Optional: custom base URL for proxies (e.g. AWS Bedrock proxy)
# ANTHROPIC_BASE_URL=https://your-proxy.example.com/

# Model names (defaults to standard Claude models)
# ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-5
# ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5

# Chainlit auth (username/password for the chat UI)
DISTILL_USER=align
DISTILL_PASSWORD=distill2024

# Admin dashboard password
DISTILL_ADMIN_PASSWORD=distill-admin-2024

# Chainlit JWT secret (generate with: chainlit create-secret)
CHAINLIT_AUTH_SECRET=your-secret-here

# Path to source data directory (used by ingest.py and rag_service.py)
DATA_DIR=/path/to/your/lenny-data

# Optional: email for health agent alerts
# DISTILL_ALERT_EMAIL=you@example.com
